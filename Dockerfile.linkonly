FROM --platform=${TARGETPLATFORM:-linux/amd64} arm32v6/alpine:edge AS build
RUN apk add --no-cache \
    g++ \
    gc-dev \
    gc-static \
    pcre2-dev \
    pcre2-static \
    yaml-dev \
    yaml-static \
    openssl-dev \
    openssl-libs-static \
    libxml2-dev \
    libxml2-static \
    zlib-dev \
    zlib-static \
    xz-dev \
    xz-static \
    git \
    cmake \
    libtool \
    m4 \
    automake \
    autoconf \
    make \
    linux-headers \
    libjpeg-turbo-static

WORKDIR /app
RUN rm -rf alsa-lib ogg opus
RUN git clone https://github.com/alsa-project/alsa-lib.git

WORKDIR /app/alsa-lib
RUN git checkout --detach a7babcb8e6361719bf18fa96f11354d125447500
RUN git -c user.name=KV -c user.email=build@localhost cherry-pick f84cd4ced7b36fddb8e4ee24404cf7c091d27020 f8253a68baf9a5f57cdff1cd178920d13e5beb2b 81c4a89eb445f8e991ca80ab55b5649530c0aacd
RUN which libtoolize
RUN libtoolize --force --copy --automake
RUN aclocal 
RUN autoheader 
RUN automake --foreign --copy --add-missing 
RUN autoconf 
RUN ./configure --enable-shared=no --enable-static=yes --disable-dependency-tracking
RUN make
RUN cp src/.libs/libasound.a /usr/lib

WORKDIR /app
RUN git clone https://github.com/xiph/ogg.git
WORKDIR /app/ogg
RUN git checkout --detach be05b13e98b048f0b5a0f5fa8ce514d56db5f822
RUN mkdir build 
WORKDIR /app/ogg/build
RUN cmake .. 
RUN make
RUN cp libogg.a /usr/lib

WORKDIR /app
RUN git clone https://github.com/xiph/opus.git
WORKDIR /app/opus
RUN git checkout --detach ddbe48383984d56acd9e1ab6a090c54ca6b735a6 
WORKDIR /app/opus/build
RUN cmake .. 
RUN make CFLAGS="-mfloat-abi=soft"
RUN cp libopus.a /usr/lib
