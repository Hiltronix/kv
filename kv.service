[Unit]
Description=KV: Privacy-focused remote KVM
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/kv/kv.env
Environment=KEMAL_ENV=production
StateDirectory=kv
StateDirectoryMode=0700
WorkingDirectory=/var/lib/kv
ExecStart=/usr/local/bin/kv -b 127.0.0.1 -p 3000 -r 720p
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
# Root and device/configfs access remain necessary for the USB gadget.
ReadWritePaths=-/sys/kernel/config

[Install]
WantedBy=multi-user.target
